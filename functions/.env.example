# Firebase project ID
GCLOUD_PROJECT=your-firebase-project-id

# AWS credentials for Transcribe + S3 + SNS integration
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-transcribe-temp-bucket

# Email service configuration (Nodemailer / Resend SMTP)
SMTP_CONNECTION_URI=smtps://resend:re_your_api_key@smtp.resend.com:465
DEFAULT_FROM=LangReels <noreply@yourdomain.com>
DEFAULT_REPLY_TO=support@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
